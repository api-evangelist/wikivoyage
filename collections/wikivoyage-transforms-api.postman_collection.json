      "item": [
        {
          "id": "2f87de9c-b66f-4fe4-88a1-aac8888bac74",
          "name": "Wikivoyage Core REST Transform Wikitext to HTML",
          "request": {
            "name": "Wikivoyage Core REST Transform Wikitext to HTML",
            "description": {
              "content": "Convert Wikivoyage wikitext into rendered HTML in the context of a given travel article title. Enables custom rendering of travel content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "transform",
                "wikitext",
                "to",
                "html",
                ":title"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "title",
                  "description": "(Required) URL-encoded travel article title"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wikitext\": \"<string>\",\n  \"body_only\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "564415ae-0791-4c7d-94d2-2d23d4f182f4",
              "name": "HTML output",
              "originalRequest": {
                "url": {
                  "path": [
                    "transform",
                    "wikitext",
                    "to",
                    "html",
                    ":title"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "title",
                      "description": "(Required) URL-encoded travel article title"
                    }
                  ]
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "text/html"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"wikitext\": \"'''Paris''' is the capital of France.\",\n  \"body_only\": \"<boolean>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
